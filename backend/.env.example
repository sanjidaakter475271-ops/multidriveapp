# MultiDrive OAuth Backend — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web Application type)
GOOGLE_CLIENT_ID=1053073934306-multidrive.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# The redirect URI configured in Google Cloud Console (must match exactly)
# Example: https://multidrive-auth.yourdomain.com/oauth/callback
REDIRECT_URI=https://multidrive-auth.example.com/oauth/callback

# Your backend's own public base URL (used to generate redirect_uri)
BASE_URL=https://multidrive-auth.example.com

# Port to listen on (Cloudflare tunnels to this local port)
PORT=3000

# Secret key for signing/verifying CSRF state tokens (use a long random string)
STATE_SECRET=change_this_to_a_long_random_secret_string_at_least_32_chars
